           cibles: [repo]
           historique_git: requis
 
+  - id: IAC_SCAN
+    description: >
+      Analyse des fichiers d'infrastructure-as-code (Terraform) : mauvaises
+      configurations de sécurité détectées avant déploiement — bucket public,
+      volume non chiffré, réseau ouvert sur tout Internet.
+    domaines: [cloud, iac]
+    entree: [cible]
+    sortie: finding/iac-issue
+    providers:
+      # ------------------------------------------------------------------ CHECKOV
+      # Provider ajouté par manifest (niveau 1) le 2026-08-28.
+      # Vérifié par exécution : résultats identiques avec et sans réseau
+      # (bwrap --unshare-net, 38 findings sur testrepo_iac) ; la sortie n'écho
+      # pas le faux secret de la fixture (leçon #1).
+      - id: checkov
+        kind: tool
+        mode: CLI
+        risque: PASSIVE
+        cout: moyen
+        commande: ["checkov"]
+        manifest:
+          id: checkov
+          kind: tool
+          mode: cli
+          binaire: checkov
+          # LISTE d'arguments, jamais une chaîne shell.
+          argv:
+            - "{BIN}"
+            - "-d"
+            - "{TARGET}"
+            - "--framework"
+            - "terraform"
+            - "--output"
+            - "json"
+            - "--quiet"
+          output:
+            format: json
+          extraction:
+            modele: plat
+            items_from: results.failed_checks
+            champs:
+              regle: check_id
+              nom_regle: check_name
+              fichier: file_path
+              ligne: file_line_range[0]
+              # description et short_description sont TOUJOURS null dans la sortie OSS
+              # (mesuré : 0/15 le 2026-08-28). check_name est le seul texte lisible :
+              # dupliqué en message plutôt que de laisser le rapport humain vide.
+              message: check_name
+              severite: severity
+              reference: guideline
+            # Aucune fuite mesurée sur la fixture, mais déclaré par précaution :
+            # description est du texte libre, même principe que issue_text (Bandit).
+            masquer_large: [message]
+          risk: PASSIVE
+          target_types: [repository]
+          # checkov sort en 1 quand il trouve des non-conformités : pas une erreur.
+          code_succes: [0, 1]
+          limite: >
+            Framework terraform uniquement dans cette déclaration : avec plusieurs
+            frameworks, checkov produit une racine JSON en liste que le modèle plat
+            ne lit pas — kubernetes et dockerfile ne sont donc PAS couverts ici
+            (une déclaration sœur peut les ajouter sans toucher au cœur).
+            severity est null dans la sortie OSS (mesuré le 2026-08-28) : la gravité
+            remontera « indéterminée », jamais inventée (leçon #4).
+
