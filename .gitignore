# Python
__pycache__/
*.pyc
.venv/

# Artefacts d'exécution éphémères (run/ est vidé à chaque mission)
PHASE3/run/
PHASE3/dogfooding/logs/
*.log

# Montages de la sandbox — recréés par bootstrap.sh
PHASE3/mt-*/

# Clones tiers (reproductibles : commits figés dans TARGETS.yaml et les scripts de test)
PHASE3/dogfooding/cibles/
PHASE3/dogfooding/axios/
PHASE3/dogfooding/eslint/
PHASE3/dogfooding/express/
PHASE3/dogfooding/mux/
PHASE3/dogfooding/terraform-aws-s3-bucket/
PHASE3/cible_independante/

# Artefacts de seconde exécution du harnais
**/_stabilite/

# Journaux de session (contexte de travail transféré, pas du code)
uploads/

# Artefacts d'exécution par run_id (régénérables) — SAUF le journal des missions
# (append-only : c'est la traçabilité du projet, elle reste versionnée)
PHASE3/artifacts/*
!PHASE3/artifacts/missions/

# Kits de transfert historiques (dépassés par l'état courant)
_transfert/testrepo_iac/

# Fixtures : leurs dépôts git internes sont recréés par reconstruire_fixtures.sh
PHASE3/testrepo/.git/
PHASE3/testrepo_go/.git/
PHASE3/testrepo_xtool/.git/

# Marqueurs d'environnement sandbox / caches d'outils locaux
.sudo_as_admin_successful
.semgrep/

# Caches d outils (bootstrap.sh recrée : ~3,7 Go)
.cache/
